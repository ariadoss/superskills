#!/usr/bin/env bats
# scripts/qa-triggers.sh decides whether /db-optimize and /qa are owed for a diff.
# Regression: a Python repo (schema.py, statements.py, Jinja templates) matched none
# of the old folder globs, so /qa-full and /daily-qa marked both NOT-TRIGGERED.
# Hermetic: builds a throwaway git repo under BATS_TEST_TMPDIR.

setup() {
  TRIG="$(cd "$BATS_TEST_DIRNAME/.." && pwd)/scripts/qa-triggers.sh"
  R="$BATS_TEST_TMPDIR/repo"
  mkdir -p "$R" && cd "$R"
  git init -q -b main
  git config user.email t@example.test; git config user.name T
  echo base > README.md; git add -A; git commit -qm base
  git switch -q -c feature
}

commit_file() { mkdir -p "$(dirname "$1")"; printf '%s\n' "$2" > "$1"; git add -A; git commit -qm "$1"; }

@test "db: a Python schema module triggers by its name" {
  commit_file scripts/lib/ats_db/schema.py 'TABLES = []'
  run "$TRIG" db main
  [ "$status" -eq 0 ]
  [[ "$output" == *"scripts/lib/ats_db/schema.py"* ]] || false
}

@test "db: statements and migration module names trigger" {
  commit_file scripts/lib/ats_db/statements.py 'X = 1'
  commit_file scripts/lib/ats_db/migrations_social.py 'Y = 1'
  run "$TRIG" db main
  [ "$status" -eq 0 ]
  [[ "$output" == *"statements.py"* ]] || false
  [[ "$output" == *"migrations_social.py"* ]] || false
}

@test "db: SQL added inside an innocently named file triggers on content" {
  commit_file web/routes/report.py 'cur.execute("SELECT id FROM jobs WHERE open = 1")'
  run "$TRIG" db main
  [ "$status" -eq 0 ]
  [[ "$output" == *"web/routes/report.py"* ]] || false
}

@test "db: an execute call with a variable query triggers" {
  commit_file lib/x.py 'conn.executemany(sql, rows)'
  run "$TRIG" db main
  [ "$status" -eq 0 ]
}

@test "db: the classic folder layout still triggers" {
  commit_file app/models/user.rb 'class User; end'
  run "$TRIG" db main
  [ "$status" -eq 0 ]
}

@test "db: prose that mentions SELECT does not trigger" {
  commit_file docs/notes.md 'We SELECT the best option FROM the list.'
  run "$TRIG" db main
  [ "$status" -eq 1 ]
}

@test "db: a diff with no database signal exits 1 and says what it searched" {
  commit_file src/util.py 'def add(a, b): return a + b'
  run "$TRIG" db main
  [ "$status" -eq 1 ]
  [[ "$output" == *"searched"* ]] || false
  [[ "$output" == *"1 changed file"* ]] || false
}

@test "ui: Jinja templates trigger" {
  commit_file web/templates/app/admin_social.html '<form></form>'
  run "$TRIG" ui main
  [ "$status" -eq 0 ]
  [[ "$output" == *"web/templates/app/admin_social.html"* ]] || false
}

@test "ui: JS framework files and stylesheets still trigger" {
  commit_file src/App.tsx 'export default 1'
  commit_file src/site.css 'a{}'
  run "$TRIG" ui main
  [ "$status" -eq 0 ]
  [[ "$output" == *"App.tsx"* ]] || false
  [[ "$output" == *"site.css"* ]] || false
}

@test "ui: a static asset directory triggers" {
  commit_file web/static/app.js 'var x'
  run "$TRIG" ui main
  [ "$status" -eq 0 ]
}

@test "ui: docs html and markdown do not trigger" {
  commit_file docs/guide.md '# hi'
  commit_file docs/site/index.html '<p>x</p>'
  run "$TRIG" ui main
  [ "$status" -eq 1 ]
}

@test "ui: a backend-only diff exits 1 and says what it searched" {
  commit_file lib/x.py 'x = 1'
  run "$TRIG" ui main
  [ "$status" -eq 1 ]
  [[ "$output" == *"searched"* ]] || false
}

@test "uncommitted changes count as part of the diff" {
  echo 'CREATE TABLE t (id int);' > new.sql
  run "$TRIG" db main
  [ "$status" -eq 0 ]
  [[ "$output" == *"new.sql"* ]] || false
}

@test "generated bytecode and caches never count" {
  mkdir -p lib/__pycache__ && echo x > lib/__pycache__/schema.cpython-311.pyc
  run "$TRIG" db main
  [ "$status" -eq 1 ]
}

@test "usage: unknown kind exits 2" {
  run "$TRIG" bogus main
  [ "$status" -eq 2 ]
}

@test "usage: bad ref exits 2" {
  run "$TRIG" db no-such-ref
  [ "$status" -eq 2 ]
}
