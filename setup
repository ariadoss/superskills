#!/usr/bin/env bash
set -e
umask 077

# ── Flags ──────────────────────────────────────────────────────────────────────
QUIET=0
NO_KNOWLEDGE=0
EXTEND_FROM=""
INSTALL_CURSOR=0
INSTALL_CLINE=0
PACKS_ARG=""
PACKS_GIVEN=0
LIST_SKILLS=0
PERSIST_ONLY=0

usage() {
  cat <<'USAGE'
Usage: ./setup [options]
  -q, --quiet            less output
  --no-knowledge         skip knowledge-base prompts and clones
  --extend-from <path>   overlay repo to extend from
  --packs <list>         comma list of packs: coding (always included; listed
                         by default), core, design, marketing, media, gstack,
                         all. Persisted for upgrades.
  --list-skills          print the resolved source paths of the selected skills
                         and exit (read-only: installs nothing, saves nothing)
  --persist-only         save the --packs selection and exit (installs nothing)
  --cursor               also write project-level Cursor rules (.cursor/rules)
  --cline                also write project-level Cline/Roo rules (.clinerules)
  -h, --help             show this help and exit (installs nothing)
USAGE
}

# Unknown flags stop here: falling through would run a full install.
while [ $# -gt 0 ]; do
  case "$1" in
    -q|--quiet)        QUIET=1; shift ;;
    --no-knowledge)    NO_KNOWLEDGE=1; shift ;;
    --extend-from)     [ $# -ge 2 ] || { echo "--extend-from needs a path" >&2; exit 2; }
                       EXTEND_FROM="$2"; shift 2 ;;
    --extend-from=*)   EXTEND_FROM="${1#--extend-from=}"; shift ;;
    --packs)           [ $# -ge 2 ] || { echo "--packs needs a comma list" >&2; exit 2; }
                       PACKS_ARG="$2"; PACKS_GIVEN=1; shift 2 ;;
    --packs=*)         PACKS_ARG="${1#--packs=}"; PACKS_GIVEN=1; shift ;;
    --list-skills)     LIST_SKILLS=1; shift ;;
    --persist-only)    PERSIST_ONLY=1; shift ;;
    --cursor)          INSTALL_CURSOR=1; shift ;;
    --cline)           INSTALL_CLINE=1; shift ;;
    -h|--help)         usage; exit 0 ;;
    *) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

log() { [ "$QUIET" -eq 0 ] && echo "$@" || true; }

# ── Directories ────────────────────────────────────────────────────────────────
SOURCE_DIR="$(cd "$(dirname "$0")" && pwd -P)"
SKILLS_SRC_DIR="$SOURCE_DIR/skills"

# Shared skill name/desc/body resolution + symlink helpers (unit-tested in
# tests/skills-lib.bats). Single source of truth for all per-tool linkers.
# shellcheck source=scripts/lib/skills-lib.sh
. "$SOURCE_DIR/scripts/lib/skills-lib.sh"
# shellcheck source=scripts/lib/gstack-install-lib.sh
. "$SOURCE_DIR/scripts/lib/gstack-install-lib.sh"

# ── Pack selection ─────────────────────────────────────────────────────────────
# Validate before anything else: an invalid list must never mutate or install.
# Flags are validated before the conf is read, and --packs (given) wins over a
# persisted selection; with no flag the persisted selection is preserved.
if [ "$PACKS_GIVEN" -eq 1 ]; then
  packs_validate "$PACKS_ARG" || exit 2
  SS_PACKS="$PACKS_ARG"
else
  packs_load
fi

# Before the banner so --list-skills stdout stays pure machine-readable paths.
if [ "$LIST_SKILLS" -eq 1 ]; then
  selected_source_paths "$SKILLS_SRC_DIR" "$SOURCE_DIR/design-skills" "$SOURCE_DIR/marketing-skills"
  exit 0
fi

if [ "$PERSIST_ONLY" -eq 1 ]; then
  [ "$PACKS_GIVEN" -eq 1 ] || { echo "--persist-only needs --packs" >&2; exit 2; }
  packs_save "$PACKS_ARG"
  log "  [ok] pack selection saved: $PACKS_ARG"
  exit 0
fi

# Every full run persists the effective selection: a --packs run re-persists
# the given list, a plain run stamps the loaded (default: coding) selection so
# the doctor can tell a packs-era install from a pre-packs one and the
# deselected prune below knows what this checkout owns.
packs_save "${SS_PACKS:-coding}"

# ── Banner ─────────────────────────────────────────────────────────────────────
log ""
log "  superskills setup  (v$(cat "$SOURCE_DIR/VERSION" 2>/dev/null | tr -d '[:space:]'))"
log "  ──────────────────────────────"
log ""
log "  packs: ${SS_PACKS:-coding}"

# Canonical version, stamped into artifacts for tools that have no native
# update detection (Windsurf/Cursor/Cline/Continue) so the active version is
# visible in the model's context. Claude Code and Codex get it natively via the
# plugin manifests (kept in sync by scripts/sync-version.sh).
SS_VERSION="$(tr -d '[:space:]' < "$SOURCE_DIR/VERSION" 2>/dev/null || echo "unknown")"
CLAUDE_SKILLS_DIR="$HOME/.claude/skills"
OPENCODE_SKILLS_DIR="$HOME/.config/opencode/skills"
CODEX_SKILLS_DIR="$HOME/.codex/skills"
CONTINUE_PROMPTS_DIR="$HOME/.continue/prompts"
WINDSURF_MEM_DIR="$HOME/.codeium/windsurf/memories"
AUGMENT_COMMANDS_DIR="$HOME/.augment/commands/superskills"
CONFIG_DIR="$HOME/.superskills"
KB_CONF="$CONFIG_DIR/knowledge.conf"

mkdir -p "$CONFIG_DIR"

# ── Knowledge base configuration ──────────────────────────────────────────────
if [ "$NO_KNOWLEDGE" -eq 0 ]; then
  KB_DIR="$CONFIG_DIR/knowledge"
  mkdir -p "$KB_DIR"

  # If no knowledge.conf exists and we're interactive, prompt for repos
  if [ ! -f "$KB_CONF" ] && [ -t 0 ] && [ "$QUIET" -eq 0 ]; then
    log "  Knowledge Base Setup"
    log "  ────────────────────"
    log "  You can connect git repos as knowledge bases that /kb-advisor"
    log "  and /content-writer (core pack) will search and reference."
    log ""
    log "  Format: name, git URL (or 'done' to finish, 'skip' to skip)"
    log ""

    while true; do
      printf "  KB name (or done/skip): "
      read -r kb_name </dev/tty 2>/dev/null || break
      [ -z "$kb_name" ] && continue
      [ "$kb_name" = "done" ] && break
      [ "$kb_name" = "skip" ] && break

      printf "  Git URL for '$kb_name': "
      read -r kb_url </dev/tty 2>/dev/null || break
      [ -z "$kb_url" ] && continue

      printf "  Description (optional): "
      read -r kb_desc </dev/tty 2>/dev/null || kb_desc=""
      [ -z "$kb_desc" ] && kb_desc="Knowledge base: $kb_name"

      echo "$kb_name|~/.superskills/knowledge/$kb_name|$kb_desc|$kb_url" >> "$KB_CONF"
      log "  [added] $kb_name"
      log ""
    done
    log ""
  elif [ ! -f "$KB_CONF" ]; then
    # Non-interactive — create empty config
    touch "$KB_CONF"
  fi

  # Clone any knowledge repos that aren't present
  if [ -f "$KB_CONF" ] && [ -s "$KB_CONF" ]; then
    log "  Checking knowledge bases..."
    while IFS='|' read -r name path desc url; do
      [ -z "$name" ] && continue
      [[ "$name" = \#* ]] && continue
      resolved="${path/#\~/$HOME}"
      if [ -d "$resolved/.git" ]; then
        log "  [ok] $name already cloned"
      elif [ -n "$url" ]; then
        log "  [clone] $name"
        git clone --quiet "$url" "$resolved" 2>/dev/null || {
          log "  [warn] Failed to clone $name — check access to $url"
          continue
        }
        log "  [ok] $name cloned"
      else
        log "  [skip] $name — no URL configured"
      fi
    done < "$KB_CONF"
    log ""
  fi
fi

# ── Repomap tool ──────────────────────────────────────────────────────────────
# Honor $REPOMAP_HOME if set (matches scripts/run.sh in the upstream repo);
# otherwise default to ~/claude-repomap-command.
REPOMAP_DIR="${REPOMAP_HOME:-$HOME/claude-repomap-command}"
if [ -d "$REPOMAP_DIR/.git" ]; then
  log "  [ok] repomap tool already installed at $REPOMAP_DIR"
else
  log "  [clone] repomap tool → $REPOMAP_DIR"
  git clone --quiet https://github.com/ariadoss/repomap.git "$REPOMAP_DIR" 2>/dev/null || {
    log "  [warn] Failed to clone repomap tool"
  }
  [ -d "$REPOMAP_DIR/.git" ] && log "  [ok] repomap tool installed"
fi
log ""

# ── gstack (Garry Tan) ────────────────────────────────────────────────────────
GSTACK_DIR="$HOME/.claude/skills/gstack"
GSTACK_VENDOR_DIR="$SOURCE_DIR/vendor/gstack"

# The gstack pack's install gate: without gstack selected, nothing is installed
# or updated here — an existing gstack install is left exactly as it is.
if [ "$(gstack_pack_action)" = "ensure" ]; then
  # Ensure bun is installed (required by gstack's browser tool) unless gstack is
  # already a real install that has been through its own setup.
  if [ "$(gstack_install_state "$GSTACK_DIR")" != "real" ] && ! command -v bun >/dev/null 2>&1; then
    log "  [install] bun (required by gstack)..."
    curl -fsSL https://bun.sh/install | bash >/dev/null 2>&1 || {
      log "  [warn] bun install failed — gstack browse tool may not work"
      log "         Install manually: curl -fsSL https://bun.sh/install | bash"
    }
    # Reload PATH to pick up bun
    export PATH="$HOME/.bun/bin:$PATH"
  fi

  # State machine (scripts/lib/gstack-install-lib.sh): a real clone is the goal;
  # the vendor snapshot is a stopgap that every later run tries to promote.
  # `|| true`: a failed install is logged, never aborts setup under `set -e`.
  gstack_ensure "$GSTACK_DIR" "$GSTACK_VENDOR_DIR" || true
else
  log "  [skip] gstack pack not selected — gstack left as-is"
  log "         (add gstack to --packs to install or update it)"
fi
log ""

# ── Dependency checks ─────────────────────────────────────────────────────────
if command -v clearwing >/dev/null 2>&1; then
  log "  [ok] clearwing found"
else
  log "  [optional] clearwing not found — needed for /pentest"
  log "             Install: uv tool install clearwing && clearwing setup"
fi

if command -v ffuf >/dev/null 2>&1; then
  log "  [ok] ffuf found"
else
  log "  [optional] ffuf not found — needed for /fuzz"
  log "             Install: brew install ffuf"
fi

log ""

# ── Link skills into Claude Code ──────────────────────────────────────────────
log "  Linking skills (Claude Code)..."
LINKED=()

# Pack gate shared by every per-tool walk: marketing's media subtree
# (content/video-editing) answers to the media pack, everything else to its
# own category. Deselected skills return 1 — never linked, never fatal.
ss_selected() {
  local name="$1" category="$2" skill_md="$3"
  if [ "$category" = "marketing" ]; then
    # The media-subtree mapping lives once in skills-lib (shared with
    # --list-skills, the doctor and the deselected prune).
    category="$(pack_category_for_path "$skill_md" "$MARKETING_SRC_DIR")"
  fi
  skill_selected "$name" "$category"
}

link_skill_claude() {
  local skill_name
  # `|| return 0`: a skill with no resolvable name is skipped, not fatal — keeps
  # the old skip-semantics so a standalone call can't abort setup under `set -e`.
  skill_name="$(link_skill_into "$CLAUDE_SKILLS_DIR" "$1" "$2" 1)" || return 0
  [ -n "$skill_name" ] && LINKED+=("$skill_name")
}

link_claude_filtered() {
  local skill_md="$1" fallback_name="$2" category="$3" name
  name="$(skill_name_from "$skill_md" "$fallback_name")"
  ss_selected "$name" "$category" "$skill_md" || return 0
  link_skill_claude "$skill_md" "$fallback_name"
}

# Marketing skills (processed first; design and superskills override any name conflicts)
MARKETING_SRC_DIR="$SOURCE_DIR/marketing-skills"
if [ -d "$MARKETING_SRC_DIR" ]; then
  while IFS= read -r skill_md; do
    skill_dir="$(dirname "$skill_md")"
    rel_path="${skill_dir#$MARKETING_SRC_DIR/}"
    fallback_name=$(echo "$rel_path" | tr '/' '-')
    link_claude_filtered "$skill_md" "$fallback_name" marketing
  done < <(marketing_skill_files "$MARKETING_SRC_DIR")
fi

# Design skills (override any marketing-skills name conflicts)
DESIGN_SRC_DIR="$SOURCE_DIR/design-skills"
if [ -d "$DESIGN_SRC_DIR" ]; then
  for skill_md in "$DESIGN_SRC_DIR"/*/SKILL.md; do
    [ -f "$skill_md" ] || continue
    skill_dir="$(dirname "$skill_md")"
    dir_name="$(basename "$skill_dir")"
    [ "$dir_name" = "node_modules" ] && continue
    link_claude_filtered "$skill_md" "$dir_name" design
  done
fi

# Superskills (override any design/marketing-skills name conflicts)
for skill_md in "$SKILLS_SRC_DIR"/*/SKILL.md; do
  [ -f "$skill_md" ] || continue
  skill_dir="$(dirname "$skill_md")"
  dir_name="$(basename "$skill_dir")"
  [ "$dir_name" = "node_modules" ] && continue
  link_claude_filtered "$skill_md" "$dir_name" core
done

log "  linked: ${#LINKED[@]} skills"
# Links this checkout created that no longer resolve (a renamed or removed
# skill) would otherwise linger as broken slash commands.
while IFS= read -r pruned; do log "  [prune] $pruned"; done < <(prune_dangling_links "$CLAUDE_SKILLS_DIR" "$SOURCE_DIR")
# A persisted pack selection also prunes THIS checkout's now-deselected
# installs — without this, upgrading a full install leaves every deselected
# skill's description loading in every session forever. No packs.conf means a
# pre-packs install: nothing is deselected by surprise.
if [ -f "$CONFIG_DIR/packs.conf" ]; then
  while IFS= read -r pruned; do log "  [prune] $pruned (deselected)"; done < <(prune_deselected_skills "$CLAUDE_SKILLS_DIR" "$SOURCE_DIR")
fi
log ""

# ── Link skills into OpenCode ─────────────────────────────────────────────────
log "  Linking skills (OpenCode)..."
mkdir -p "$OPENCODE_SKILLS_DIR"

link_skill_opencode() {
  link_skill_into "$OPENCODE_SKILLS_DIR" "$1" "$2" 0 "superskills-" >/dev/null || return 0
}

link_opencode_filtered() {
  local skill_md="$1" fallback_name="$2" category="$3" name
  name="$(skill_name_from "$skill_md" "$fallback_name")"
  ss_selected "$name" "$category" "$skill_md" || return 0
  link_skill_opencode "$skill_md" "$fallback_name"
}

if [ -d "$MARKETING_SRC_DIR" ]; then
  while IFS= read -r skill_md; do
    skill_dir="$(dirname "$skill_md")"
    rel_path="${skill_dir#$MARKETING_SRC_DIR/}"
    fallback_name=$(echo "$rel_path" | tr '/' '-')
    link_opencode_filtered "$skill_md" "$fallback_name" marketing
  done < <(marketing_skill_files "$MARKETING_SRC_DIR")
fi

if [ -d "$DESIGN_SRC_DIR" ]; then
  for skill_md in "$DESIGN_SRC_DIR"/*/SKILL.md; do
    [ -f "$skill_md" ] || continue
    skill_dir="$(dirname "$skill_md")"
    dir_name="$(basename "$skill_dir")"
    [ "$dir_name" = "node_modules" ] && continue
    link_opencode_filtered "$skill_md" "$dir_name" design
  done
fi

for skill_md in "$SKILLS_SRC_DIR"/*/SKILL.md; do
  [ -f "$skill_md" ] || continue
  skill_dir="$(dirname "$skill_md")"
  dir_name="$(basename "$skill_dir")"
  [ "$dir_name" = "node_modules" ] && continue
  link_opencode_filtered "$skill_md" "$dir_name" core
done

while IFS= read -r pruned; do log "  [prune] $pruned"; done < <(prune_dangling_links "$OPENCODE_SKILLS_DIR" "$SOURCE_DIR")
if [ -f "$CONFIG_DIR/packs.conf" ]; then
  while IFS= read -r pruned; do log "  [prune] $pruned (deselected)"; done < <(prune_deselected_skills "$OPENCODE_SKILLS_DIR" "$SOURCE_DIR")
fi
log "  done"
log ""

# Description/body extraction now live in scripts/lib/skills-lib.sh as
# skill_desc_from / skill_body_from (sourced above) — single source of truth.

# ── OpenAI Codex CLI ──────────────────────────────────────────────────────────
if [ -d "$HOME/.codex" ]; then
  log "  Linking skills (OpenAI Codex CLI)..."
  mkdir -p "$CODEX_SKILLS_DIR"
  CODEX_LINKED=0

  link_skill_codex() {
    # `if` (not `&&`) so a skipped skill returns 0 — can't abort setup under set -e.
    if link_skill_into "$CODEX_SKILLS_DIR" "$1" "$2" 1 >/dev/null; then
      CODEX_LINKED=$((CODEX_LINKED + 1))
    fi
  }

  link_codex_filtered() {
    local skill_md="$1" dir_name="$2" name
    name="$(skill_name_from "$skill_md" "$dir_name")"
    ss_selected "$name" core "$skill_md" || return 0
    link_skill_codex "$skill_md" "$dir_name"
  }

  for skill_md in "$SKILLS_SRC_DIR"/*/SKILL.md; do
    [ -f "$skill_md" ] || continue
    dir_name="$(basename "$(dirname "$skill_md")")"
    [ "$dir_name" = "node_modules" ] && continue
    link_codex_filtered "$skill_md" "$dir_name"
  done
  while IFS= read -r pruned; do log "  [prune] $pruned"; done < <(prune_dangling_links "$CODEX_SKILLS_DIR" "$SOURCE_DIR")
  if [ -f "$CONFIG_DIR/packs.conf" ]; then
    while IFS= read -r pruned; do log "  [prune] $pruned (deselected)"; done < <(prune_deselected_skills "$CODEX_SKILLS_DIR" "$SOURCE_DIR")
  fi
  log "  linked: $CODEX_LINKED skills"
  log ""
fi

# ── Continue.dev ──────────────────────────────────────────────────────────────
if [ -d "$HOME/.continue" ]; then
  log "  Linking skills (Continue.dev)..."
  mkdir -p "$CONTINUE_PROMPTS_DIR"
  CONTINUE_LINKED=0

  link_skill_continue() {
    local skill_md="$1" fallback_name="$2"
    local name desc body
    name="$(skill_name_from "$skill_md" "$fallback_name")"
    [ -z "$name" ] && return
    ss_selected "$name" core "$skill_md" || return 0
    desc=$(skill_desc_from "$skill_md")
    body=$(skill_body_from "$skill_md")
    printf 'name: %s\ndescription: %s\n---\n%s\n' "$name" "$desc" "$body" \
      > "$CONTINUE_PROMPTS_DIR/$name.prompt"
    CONTINUE_LINKED=$((CONTINUE_LINKED + 1))
  }

  for skill_md in "$SKILLS_SRC_DIR"/*/SKILL.md; do
    [ -f "$skill_md" ] || continue
    dir_name="$(basename "$(dirname "$skill_md")")"
    [ "$dir_name" = "node_modules" ] && continue
    link_skill_continue "$skill_md" "$dir_name"
  done
  log "  linked: $CONTINUE_LINKED skills"
  log ""
fi

# ── Augment Code ──────────────────────────────────────────────────────────────
if [ -d "$HOME/.augment" ]; then
  log "  Linking skills (Augment Code)..."
  mkdir -p "$AUGMENT_COMMANDS_DIR"
  AUGMENT_LINKED=0

  link_skill_augment() {
    local skill_md="$1" fallback_name="$2"
    local name body
    name="$(skill_name_from "$skill_md" "$fallback_name")"
    [ -z "$name" ] && return
    ss_selected "$name" core "$skill_md" || return 0
    body=$(skill_body_from "$skill_md")
    printf '# /%s\n\n%s\n' "$name" "$body" > "$AUGMENT_COMMANDS_DIR/$name.md"
    AUGMENT_LINKED=$((AUGMENT_LINKED + 1))
  }

  for skill_md in "$SKILLS_SRC_DIR"/*/SKILL.md; do
    [ -f "$skill_md" ] || continue
    dir_name="$(basename "$(dirname "$skill_md")")"
    [ "$dir_name" = "node_modules" ] && continue
    link_skill_augment "$skill_md" "$dir_name"
  done
  log "  linked: $AUGMENT_LINKED skills"
  log ""
fi

# ── Windsurf ──────────────────────────────────────────────────────────────────
if [ -d "$HOME/.codeium/windsurf" ]; then
  log "  Writing skills reference (Windsurf)..."
  mkdir -p "$WINDSURF_MEM_DIR"
  {
    printf '# Superskills — Available Slash Commands\n\n'
    printf '**Superskills v%s** — re-run `./setup` after updating.\n\n' "$SS_VERSION"
    printf 'These commands are available. Suggest them when relevant to the task.\n\n'
    for skill_md in "$SKILLS_SRC_DIR"/*/SKILL.md; do
      [ -f "$skill_md" ] || continue
      dir_name="$(basename "$(dirname "$skill_md")")"
      [ "$dir_name" = "node_modules" ] && continue
      name="$(skill_name_from "$skill_md" "$dir_name")"
      ss_selected "$name" core "$skill_md" || continue
      desc=$(skill_desc_from "$skill_md")
      echo "- \`/$name\` — $desc"
    done
  } > "$WINDSURF_MEM_DIR/superskills.md"
  log "  written: $WINDSURF_MEM_DIR/superskills.md"
  log ""
fi

# ── Cursor (project-level — requires --cursor flag) ──────────────────────────
if [ "$INSTALL_CURSOR" -eq 1 ]; then
  CURSOR_RULES_DIR="$(pwd)/.cursor/rules"
  log "  Installing skills (Cursor rules → $CURSOR_RULES_DIR)..."
  mkdir -p "$CURSOR_RULES_DIR"
  CURSOR_LINKED=0

  for skill_md in "$SKILLS_SRC_DIR"/*/SKILL.md; do
    [ -f "$skill_md" ] || continue
    dir_name="$(basename "$(dirname "$skill_md")")"
    [ "$dir_name" = "node_modules" ] && continue
    name="$(skill_name_from "$skill_md" "$dir_name")"
    ss_selected "$name" core "$skill_md" || continue
    desc=$(skill_desc_from "$skill_md")
    body=$(skill_body_from "$skill_md")
    printf -- '---\nname: %s\ndescription: %s\nalwaysApply: false\n---\n%s\n' \
      "$name" "$desc" "$body" > "$CURSOR_RULES_DIR/superskills-$name.mdc"
    CURSOR_LINKED=$((CURSOR_LINKED + 1))
  done
  # Always-applied marker so the active superskills version is in context (Cursor
  # has no native update detection).
  printf -- '---\nname: superskills-version\ndescription: Active Superskills version\nalwaysApply: true\n---\nSuperskills v%s is installed. Re-run `./setup` after updating to refresh these rules.\n' \
    "$SS_VERSION" > "$CURSOR_RULES_DIR/superskills-version.mdc"
  log "  linked: $CURSOR_LINKED skills"
  log ""
fi

# ── Cline / Roo Code (project-level — requires --cline flag) ─────────────────
if [ "$INSTALL_CLINE" -eq 1 ]; then
  CLINE_FILE="$(pwd)/.clinerules"
  log "  Writing skills reference (Cline/Roo → $CLINE_FILE)..."
  {
    printf '# Superskills — Available Commands\n\n'
    printf '**Superskills v%s** — re-run `./setup` after updating.\n\n' "$SS_VERSION"
    printf 'The following slash commands are available. Suggest them when relevant.\n\n'
    for skill_md in "$SKILLS_SRC_DIR"/*/SKILL.md; do
      [ -f "$skill_md" ] || continue
      dir_name="$(basename "$(dirname "$skill_md")")"
      [ "$dir_name" = "node_modules" ] && continue
      name="$(skill_name_from "$skill_md" "$dir_name")"
      ss_selected "$name" core "$skill_md" || continue
      desc=$(skill_desc_from "$skill_md")
      echo "- \`/$name\` — $desc"
    done
  } > "$CLINE_FILE"
  log "  written: $CLINE_FILE"
  log ""
fi

# ── Developer workflow rule ───────────────────────────────────────────────────
GLOBAL_CLAUDE_MD="$HOME/.claude/CLAUDE.md"
WORKFLOW_MARKER="<!-- superskills-workflow-rule -->"
if ! grep -qF "$WORKFLOW_MARKER" "$GLOBAL_CLAUDE_MD" 2>/dev/null; then
  if [ -t 0 ] && [ "$QUIET" -eq 0 ]; then
    printf '  Add superskills workflow guide to ~/.claude/CLAUDE.md? [y/N] '
    read -r add_workflow </dev/tty 2>/dev/null || add_workflow=""
  else
    add_workflow="y"
  fi
  if [ "$add_workflow" = "y" ] || [ "$add_workflow" = "Y" ]; then
    mkdir -p "$(dirname "$GLOBAL_CLAUDE_MD")"
    printf '\n%s\n## Superskills Developer Workflow\n\nRead %s/DEVELOPER_WORKFLOW.md to understand how to use superskills commands together effectively — parallel agents, vertical slices, quality pipeline, performance optimization, and shipping workflow.\n' \
      "$WORKFLOW_MARKER" "$SOURCE_DIR" >> "$GLOBAL_CLAUDE_MD"
    log "  [ok] workflow rule added to $GLOBAL_CLAUDE_MD"
  fi
fi
log ""

# ── Git post-merge hook ───────────────────────────────────────────────────────
# If this is a git checkout, install a post-merge hook so a plain `git pull`
# re-runs setup and links any NEW skills. Without this, new skills stay
# invisible until setup is run again (existing skills are live symlinks).
HOOK_SRC="$SOURCE_DIR/scripts/git-hooks/post-merge"
HOOKS_DIR="$(git -C "$SOURCE_DIR" rev-parse --git-path hooks 2>/dev/null || echo "")"
if [ -n "$HOOKS_DIR" ] && [ -f "$HOOK_SRC" ]; then
  # rev-parse may return a path relative to SOURCE_DIR — resolve it
  case "$HOOKS_DIR" in /*) : ;; *) HOOKS_DIR="$SOURCE_DIR/$HOOKS_DIR" ;; esac
  mkdir -p "$HOOKS_DIR"
  if [ ! -e "$HOOKS_DIR/post-merge" ] || grep -qF "superskills post-merge hook" "$HOOKS_DIR/post-merge" 2>/dev/null; then
    cp "$HOOK_SRC" "$HOOKS_DIR/post-merge"
    chmod +x "$HOOKS_DIR/post-merge"
    log "  [ok] git post-merge hook installed (auto-links new skills on pull)"
  else
    log "  [skip] post-merge hook exists and is not ours — leaving it alone"
  fi
fi
log ""

# ── Summary ────────────────────────────────────────────────────────────────────
log "  superskills ready"
log "  ${#LINKED[@]} skills linked"
log "  tools: Claude Code, OpenCode$([ -d "$HOME/.codex" ] && echo ', Codex CLI')$([ -d "$HOME/.continue" ] && echo ', Continue.dev')$([ -d "$HOME/.augment" ] && echo ', Augment')$([ -d "$HOME/.codeium/windsurf" ] && echo ', Windsurf')"
# Only advertise the packs the run actually installed (packs_all_included covers 'all').
if packs_all_included; then
  log "  includes marketing-skills: SEO, content, pages, ads, channels, strategies"
  log "  includes design-skills: UX, frontend engineering, animation, Swift/iOS, Vercel"
else
  pack_category_included marketing && log "  includes marketing-skills: SEO, content, pages, ads, channels, strategies"
  pack_category_included media && log "  includes media pack: video editing"
  pack_category_included design && log "  includes design-skills: UX, frontend engineering, animation, Swift/iOS, Vercel"
  log "  packs: ${SS_PACKS:-coding} (change with ./setup --packs)"
fi
if [ -f "$KB_CONF" ] && [ -s "$KB_CONF" ]; then
  kb_count=$(grep -c '.' "$KB_CONF" 2>/dev/null || echo 0)
  log "  $kb_count knowledge base(s) configured"
fi
log ""
log "  Project-level installs (run from project root):"
log "    ./setup --cursor   → .cursor/rules/*.mdc  (Cursor)"
log "    ./setup --cline    → .clinerules           (Cline / Roo Code)"
log ""
log "  To update: /superskills-upgrade"
log "  To add knowledge bases: edit ~/.superskills/knowledge.conf"
log ""
